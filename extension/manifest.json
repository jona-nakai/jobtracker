{
  "manifest_version": 3,
  "name": "Job Tracker Collector",
  "version": "0.1.0",
  "description": "Collect job postings into Job Tracker.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Tracker"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.linkedin.com/*", "https://www.indeed.com/*", "https://*.supabase.co/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*", "https://www.indeed.com/*"],
      "js": ["linkedinContent.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "job-tracker-collector@example.com"
    }
  }
}
